{
  "framework": null,
  "outputDirectory": "public",
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/catalogo.py": {
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/usuarios.py": {
      "maxDuration": 60,
      "includeFiles": "server/user_admin.py"
    }
  },
  "headers": [
    {
      "source": "/config.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
